{
  "name": "exprforge",
  "version": "0.9.0",
  "description": "Author a math expression once as an AST (or readable infix text via expr/fn), emit identical-behavior implementations in 20 programming languages (JavaScript, TypeScript, QB64, C, Java, Go, Rust, C#, Python, Lua, Perl, Ruby, PHP, Julia, R, Fortran, Zig, Scheme, COBOL, and MATLAB/Octave), plus a native evaluator, typeset LaTeX output, and a printer for its own readable syntax.",
  "main": "index.js",
  "type": "commonjs",
  "exports": {
    ".": "./index.js",
    "./math": "./math/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "ast.js",
    "util.js",
    "expr.js",
    "fn.js",
    "evaluate.js",
    "differentiate.js",
    "analyze.js",
    "duplicates.js",
    "macros.js",
    "primitives.js",
    "load-expr.js",
    "build.js",
    "emitters/",
    "samples/",
    "math/"
  ],
  "scripts": {
    "dev": "npm run dev --prefix playground",
    "build": "node build.js",
    "docs:sync": "node scripts/sync-docs.js",
    "docs:check": "node scripts/sync-docs.js --check",
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-exclude=\"test/**\"",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "codegen",
    "ast",
    "math",
    "cross-language",
    "transpiler",
    "qb64",
    "r",
    "ruby",
    "latex",
    "cobol",
    "fortran",
    "matlab",
    "octave",
    "differentiation",
    "calculus"
  ],
  "license": "MIT",
  "author": {
    "name": "Don Smith",
    "url": "https://github.com/theraccoonbear"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theraccoonbear/exprforge.git"
  },
  "homepage": "https://github.com/theraccoonbear/exprforge#readme",
  "bugs": {
    "url": "https://github.com/theraccoonbear/exprforge/issues"
  }
}
