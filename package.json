{
  "name": "exprforge",
  "version": "0.1.0",
  "description": "Author a math expression once as an AST, emit identical-behavior implementations in JS, QB64, C, Java, Go, and Rust.",
  "main": "index.js",
  "type": "commonjs",
  "files": [
    "index.js",
    "ast.js",
    "util.js",
    "yaml.js",
    "build.js",
    "emitters/",
    "samples/"
  ],
  "scripts": {
    "build": "node build.js",
    "test": "node --test",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "codegen",
    "ast",
    "math",
    "cross-language",
    "transpiler",
    "qb64"
  ],
  "license": "MIT",
  "author": {
    "name": "Don Smith",
    "url": "https://github.com/theraccoonbear"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theraccoonbear/exprforge.git"
  },
  "homepage": "https://github.com/theraccoonbear/exprforge#readme",
  "bugs": {
    "url": "https://github.com/theraccoonbear/exprforge/issues"
  },
  "devDependencies": {
    "js-yaml": "^5.2.3"
  },
  "peerDependencies": {
    "js-yaml": "^4.0.0 || ^5.0.0"
  },
  "peerDependenciesMeta": {
    "js-yaml": {
      "optional": true
    }
  }
}
